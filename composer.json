{
    "name": "avangward/silent",
    "autoload": {
        "psr-4": {
            "Silent\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "bin": ["bin/silent"],
    "authors": [
        {
            "name": "Dmytrii Lukiashchenko",
            "email": "lukiaschenkoff@gmail.com"
        }
    ],
    "extra": {
        "merge-plugin": {
            "merge-plugin": {
                "include": ["plugins/*/composer.json"],
                "merge-dev": true
            }
        }
    },
    "require": {
        "php": ">=8.4",
        "symfony/http-client": "^8.1",
        "symfony/serializer-pack": "^1.4",
        "symfony/console": "^8.1",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13"
    }
}
